<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas.controller.DaftarController" stylesheets="@styles/app.css">
    <top>
        <VBox spacing="12" styleClass="header">
            <Label text="Daftar Produk" styleClass="title"/>
            <HBox spacing="10">
                <TextField fx:id="cariField" promptText="Cari nama produk..." onAction="#cari" HBox.hgrow="ALWAYS"/>
                <Button text="Cari" onAction="#cari" styleClass="button-primary"/>
                <Button text="Reset" onAction="#resetPencarian"/>
            </HBox>
            <FlowPane hgap="10" vgap="8">
                <Button text="Tambah Produk" onAction="#tambah"/>
                <Button text="Lihat Detail" onAction="#detail" styleClass="button-primary"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabel">
            <columns>
                <TableColumn fx:id="kodeCol" text="Kode" prefWidth="100"/>
                <TableColumn fx:id="namaCol" text="Nama Produk" prefWidth="250"/>
                <TableColumn fx:id="kategoriCol" text="Kategori" prefWidth="150"/>
                <TableColumn fx:id="hargaCol" text="Harga" prefWidth="150"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="pesanLabel" wrapText="true" styleClass="error"/>
    </bottom>
</BorderPane>